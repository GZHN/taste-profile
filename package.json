{
  "name": "taste-profile",
  "version": "1.6.1",
  "private": true,
  "scripts": {
    "write-version": "node ./scripts/write-version.mjs",
    "prebuild": "npm run write-version",
    "build": "spicetify-creator",
    "prebuild-local": "npm run write-version",
    "build-local": "spicetify-creator --out=dist --minify",
    "prewatch": "npm run write-version",
    "watch": "spicetify-creator --watch",
    "sync-release": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/sync-release.ps1",
    "sync-release:sh": "sh ./scripts/sync-release.sh"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "spicetify-creator": "^1.0.17",
    "typescript": "^7.0.2"
  }
}
